# no remote behavior
# ---------------------------------------------------------------------------

test_no_push_on_finish_or_release() {
    # A real bare remote, so a push would actually land refs and be detectable.
    # Merely asserting "git remote" is empty proves nothing: a script that pushed
    # and then removed the remote would pass, and an absent remote can mask a
    # push attempt entirely.
    make_project "$WORK/nopush"
    _bare="$WORK/nopush-remote.git"
    git init -q --bare "$_bare"
    (cd "$WORK/nopush" && git remote add origin "$_bare")

    run_in "$WORK/nopush" create feature 6 local-clone-invocation
    assert_status "create exits 0 against a remote" 0 "$RUN_STATUS"
    (cd "$WORK/nopush" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/nopush" finish
    assert_status "finish exits 0 against a remote" 0 "$RUN_STATUS"
    assert_count "no refs arrived after create+finish" "0" \
        "$(git --git-dir="$_bare" for-each-ref --format='%(refname)' | grep . || true)"

    # release runs directly on the base branch, so it needs its OWN fixture.
    # Reusing the one above would fail: finish already promoted and re-added
    # [Unreleased], so release would correctly refuse with an empty section.
    make_project "$WORK/nopush-release"
    _bare_release="$WORK/nopush-release-remote.git"
    git init -q --bare "$_bare_release"
    (cd "$WORK/nopush-release" && git remote add origin "$_bare_release")
    run_in "$WORK/nopush-release" release --skip-tests
    assert_status "release exits 0 against a remote" 0 "$RUN_STATUS"
    assert_count "no refs arrived after release" "0" \
        "$(git --git-dir="$_bare_release" for-each-ref --format='%(refname)' | grep . || true)"
    unset _bare _bare_release
}

