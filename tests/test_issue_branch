#!/bin/sh
# shellcheck disable=SC2329  # test functions are invoked indirectly by the runner
#
# Tests for src/issue-branch.
#
# Shell-only harness: builds a throwaway project in a temp directory, copies
# the scripts under test next to a project_settings.sh, and drives the
# lifecycle command through its branches. No external test framework.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SRC_DIR="$REPO_ROOT/src"
ISSUE_BRANCH="$SRC_DIR/issue-branch"
FUNCTIONS_SH="$SRC_DIR/functions.sh"
READ_ABOUT_VERSION="$SRC_DIR/read_about_version.py"

PASS=0
FAIL=0
FAILED_NAMES=""

# ---------------------------------------------------------------------------
# assertions
# ---------------------------------------------------------------------------

fail() {
    _name="$1"
    _detail="$2"
    printf 'FAIL: %s\n  %s\n' "$_name" "$_detail"
    FAIL=$((FAIL + 1))
    FAILED_NAMES="$FAILED_NAMES
  $_name"
}

pass() {
    PASS=$((PASS + 1))
}

assert_status() {
    _name="$1"
    _expected="$2"
    _actual="$3"
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected exit $_expected, got $_actual"
    fi
}

assert_eq() {
    _name="$1"
    _expected="$2"
    _actual="$3"
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected '$_expected', got '$_actual'"
    fi
}

assert_contains() {
    _name="$1"
    _needle="$2"
    _haystack="$3"
    case "$_haystack" in
        *"$_needle"*) pass ;;
        *) fail "$_name" "expected output to contain '$_needle'; got: $_haystack" ;;
    esac
}

assert_not_contains() {
    _name="$1"
    _needle="$2"
    _haystack="$3"
    case "$_haystack" in
        *"$_needle"*) fail "$_name" "expected output to omit '$_needle'; got: $_haystack" ;;
        *) pass ;;
    esac
}

# assert_branch <name> <dir> <expected>
assert_branch() {
    _name="$1"
    _dir="$2"
    _expected="$3"
    _actual="$(cd "$_dir" && git branch --show-current 2>/dev/null)"
    assert_eq "$_name" "$_expected" "$_actual"
}

assert_annotated_tag() {
    _name="$1"
    _dir="$2"
    _tag="$3"
    _type="$(cd "$_dir" && git cat-file -t "$_tag" 2>/dev/null)"
    assert_eq "$_name" "tag" "$_type"
}

assert_absent_tag() {
    _name="$1"
    _dir="$2"
    _tag="$3"
    _actual="$(cd "$_dir" && git tag -l "$_tag")"
    assert_eq "$_name" "" "$_actual"
}

assert_version() {
    _name="$1"
    _dir="$2"
    _expected="$3"
    _actual="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$_dir/sample/__about__.py")"
    assert_eq "$_name" "$_expected" "$_actual"
}

# assert_ne <name> <unexpected> <actual>
assert_ne() {
    _name="$1"
    _unexpected="$2"
    _actual="$3"
    if [ "$_unexpected" != "$_actual" ]; then
        pass
    else
        fail "$_name" "expected a value other than '$_unexpected'"
    fi
    unset _name _unexpected _actual
}

# assert_clean_worktree <name> <dir>
#
# Asserts the working tree has no modified or untracked files. Guards against
# a command that writes to disk without committing, which a HEAD-based
# comparison cannot see.
assert_clean_worktree() {
    _name="$1"
    _dir="$2"
    _dirty="$(cd "$_dir" && git status --porcelain)"
    if [ -z "$_dirty" ]; then
        pass
    else
        fail "$_name" "expected a clean worktree; got: $_dirty"
    fi
    unset _name _dir _dirty
}

# assert_count <name> <expected_count> <text>
#
# Counts the lines in the multi-line string <text> and compares against
# <expected_count>. Callers pre-filter (e.g. with grep) so the helper
# itself stays generic.
assert_count() {
    _name="$1"
    _expected="$2"
    _text="$3"
    if [ -z "$_text" ]; then
        _actual=0
    else
        _actual="$(printf '%s\n' "$_text" | grep -c .)"
    fi
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected $_expected matching lines, got $_actual"
    fi
    unset _name _expected _text _actual
}

# require_exists <name> <path>
#
# Precondition guard: fails and returns nonzero when a file the test depends
# on is absent. Unlike the assert_* helpers this does not record-and-return,
# nor does it touch the pass counter — a missing dependency is a precondition,
# not a contract assertion. Callers use `require_exists ... || return` so a
# missing dependency aborts the test instead of letting its body run and
# misattribute interpreter noise to contract assertions. Follows run_test's
# dependency guard (fail + return; the body never runs).
require_exists() {
    _name="$1"
    _path="$2"
    if [ -f "$_path" ]; then
        unset _name _path
        return 0
    fi
    fail "$_name" "expected '$_path' to exist"
    unset _name _path
    return 1
}

current_version_of() {
    sed -n 's/^__version__ = "\(.*\)"/\1/p' "$1/sample/__about__.py"
}

# ---------------------------------------------------------------------------
# fixture
# ---------------------------------------------------------------------------

# make_project <dir> [version]
#
# Creates a git repo at <dir> with:
#   pyproject.toml, README.md
#   sample/__about__.py           (__version__ = <version>, default 1.3.0)
#   CHANGELOG.md                  (non-empty [Unreleased], plus a 1.3.0 entry)
#   scripts/issue-branch-*        (scripts under test)
#   scripts/run-tests.sh          (overridable by the test)
#   scripts/project_settings.sh   (test project settings)
#
# The changelog always contains a released "## [1.3.0] - 2026-09-17" entry, so a
# test that releases <version> should pass a version NEWER than 1.3.0 unless it is
# deliberately exercising a re-release of 1.3.0. Releasing 1.3.0 from this
# fixture would promote [Unreleased] to a second "## [1.3.0]" heading.
make_project() {
    _dir="$1"
    _version="${2:-1.3.0}"
    mkdir -p "$_dir/sample" "$_dir/scripts"

    cat > "$_dir/pyproject.toml" <<'EOF'
[project]
name = "sample-project"
dynamic = ["version"]
EOF

    printf '__version__ = "%s"\n' "$_version" > "$_dir/sample/__about__.py"

    cat > "$_dir/README.md" <<'EOF'
# sample project
EOF

    cat > "$_dir/CHANGELOG.md" <<'EOF'
# Changelog

## [Unreleased]

### Added

- Something new.

## [1.3.0] - 2026-09-17

### Added

- Previous release.
EOF

    if ! cp "$SRC_DIR/issue-branch" "$_dir/scripts/issue-branch"; then
        fail "fixture copy issue-branch" "cannot copy $SRC_DIR/issue-branch"
        return 1
    fi
    if ! cp "$SRC_DIR/functions.sh" "$_dir/scripts/functions.sh"; then
        fail "fixture copy functions.sh" "cannot copy $SRC_DIR/functions.sh"
        return 1
    fi
    if ! cp "$SRC_DIR/read_about_version.py" "$_dir/scripts/read_about_version.py"; then
        fail "fixture copy read_about_version.py" "cannot copy $SRC_DIR/read_about_version.py"
        return 1
    fi
    # write_about_version.py is parked (absent during RED); copy only when
    # present so its absence is not an unchecked `cp:` failure. Its absence is
    # the RED signal carried by require_exists in the unit tests.
    if [ -f "$SRC_DIR/write_about_version.py" ]; then
        cp "$SRC_DIR/write_about_version.py" "$_dir/scripts/write_about_version.py"
    fi
    chmod +x "$_dir/scripts/issue-branch"

    cat > "$_dir/scripts/run-tests.sh" <<'EOF'
#!/bin/sh
exit 0
EOF
    chmod +x "$_dir/scripts/run-tests.sh"

    cat > "$_dir/scripts/project_settings.sh" <<'EOF'
ROOT_PACKAGE_NAME="sample"
ISSUE_BRANCH_TEMPLATE="dev/{issue}-{slug}"
ISSUE_BRANCH_BASE="main"
ISSUE_BRANCH_TEST_COMMAND="scripts/run-tests.sh"
ISSUE_BRANCH_CHANGELOG="CHANGELOG.md"
TWINE_UPLOAD_ENABLED="0"
EOF

    (
        cd "$_dir" || exit 1
        git init -q -b main
        git config user.email "test@example.com"
        git config user.name "Test"
        # Disable signing so throwaway repos ignore the developer's global git config.
        git config commit.gpgsign false
        git config tag.gpgsign false
        git config tag.forcesignannotated false
        git add -A
        git commit -qm "initial commit"
    )
    unset _dir _version
}

# rich_project <dir> [version]
#
# Same shape as make_project, but sample/__about__.py carries a docstring,
# __title__, __version__, __summary__, and __all__ in the PLAIN form
# (__version__ = "1.3.0"). Plain form is required: assert_version,
# current_version_of, and the git show assertions match with
# sed -n 's/^__version__ = "\(.*\)"/\1/p', so an annotated fixture would read
# as empty and fail for a helper limitation rather than a contract violation.
rich_project() {
    _dir="$1"
    _version="${2:-1.3.0}"
    mkdir -p "$_dir/sample" "$_dir/scripts"

    cat > "$_dir/pyproject.toml" <<'EOF'
[project]
name = "sample-project"
dynamic = ["version"]
EOF

    # Plain form only (see above). Version is spliced in; every other line is
    # fixed so pre/post comparisons are meaningful.
    {
        printf '"""Sample package metadata."""\n'
        printf '\n'
        printf '__title__ = "sample"\n'
        printf '__version__ = "%s"\n' "$_version"
        printf '__summary__ = "A sample project."\n'
        printf '__all__ = ["__title__", "__summary__", "__version__"]\n'
    } > "$_dir/sample/__about__.py"

    cat > "$_dir/README.md" <<'EOF'
# sample project
EOF

    cat > "$_dir/CHANGELOG.md" <<'EOF'
# Changelog

## [Unreleased]

### Added

- Something new.

## [1.3.0] - 2026-09-17

### Added

- Previous release.
EOF

    if ! cp "$SRC_DIR/issue-branch" "$_dir/scripts/issue-branch"; then
        fail "fixture copy issue-branch" "cannot copy $SRC_DIR/issue-branch"
        return 1
    fi
    if ! cp "$SRC_DIR/functions.sh" "$_dir/scripts/functions.sh"; then
        fail "fixture copy functions.sh" "cannot copy $SRC_DIR/functions.sh"
        return 1
    fi
    if ! cp "$SRC_DIR/read_about_version.py" "$_dir/scripts/read_about_version.py"; then
        fail "fixture copy read_about_version.py" "cannot copy $SRC_DIR/read_about_version.py"
        return 1
    fi
    # write_about_version.py is parked (absent during RED); copy only when
    # present so its absence is not an unchecked `cp:` failure. Its absence is
    # the RED signal carried by require_exists in the unit tests.
    if [ -f "$SRC_DIR/write_about_version.py" ]; then
        cp "$SRC_DIR/write_about_version.py" "$_dir/scripts/write_about_version.py"
    fi
    chmod +x "$_dir/scripts/issue-branch"

    cat > "$_dir/scripts/run-tests.sh" <<'EOF'
#!/bin/sh
exit 0
EOF
    chmod +x "$_dir/scripts/run-tests.sh"

    cat > "$_dir/scripts/project_settings.sh" <<'EOF'
ROOT_PACKAGE_NAME="sample"
ISSUE_BRANCH_TEMPLATE="dev/{issue}-{slug}"
ISSUE_BRANCH_BASE="main"
ISSUE_BRANCH_TEST_COMMAND="scripts/run-tests.sh"
ISSUE_BRANCH_CHANGELOG="CHANGELOG.md"
TWINE_UPLOAD_ENABLED="0"
EOF

    (
        cd "$_dir" || exit 1
        git init -q -b main
        git config user.email "test@example.com"
        git config user.name "Test"
        # Disable signing so throwaway repos ignore the developer's global git config.
        git config commit.gpgsign false
        git config tag.gpgsign false
        git config tag.forcesignannotated false
        git add -A
        git commit -qm "initial commit"
    )
    unset _dir _version
}

# run_in <dir> <args...>  -> exit status in RUN_STATUS
run_in() {
    _dir="$1"
    shift
    RUN_OUT="$(cd "$_dir" && ./scripts/issue-branch "$@" 2>&1)"
    RUN_STATUS=$?
    # shellcheck disable=SC2034  # captured for failure-message context
    LAST_OUT="$RUN_OUT"
}

# ---------------------------------------------------------------------------
# temp workspace
# ---------------------------------------------------------------------------

WORK="$(mktemp -d "${TMPDIR:-/tmp}/issue-branch-test.XXXXXX")" || {
    printf 'FAIL: mktemp -d failed; cannot run tests\n' >&2
    exit 1
}
# An empty WORK would turn every make_project path into an absolute path under
# / (e.g. "/sample"), writing outside the sandbox. Guard rather than trust.
[ -n "$WORK" ] && [ -d "$WORK" ] || {
    printf 'FAIL: mktemp -d produced no directory\n' >&2
    exit 1
}
trap 'rm -rf "$WORK"' EXIT INT TERM

# ---------------------------------------------------------------------------
# preconditions
# ---------------------------------------------------------------------------

# The command under test is the deliverable; when it is absent, every test
# fails. Report each test independently instead of aborting the run so RED
# shows the full contract surface. Predicates differ by role: issue-branch is
# an executed command (`-x`); functions.sh is a sourced library (mode 644 by
# policy) and read_about_version.py is invoked via python3, so both are guarded
# with `-f` — an `-x` check would fail at baseline and collapse the run.
COMMAND_PRESENT=1
if [ ! -x "$ISSUE_BRANCH" ]; then
    COMMAND_PRESENT=0
fi
FUNCTIONS_PRESENT=1
if [ ! -f "$FUNCTIONS_SH" ]; then
    FUNCTIONS_PRESENT=0
fi
READ_ABOUT_VERSION_PRESENT=1
if [ ! -f "$READ_ABOUT_VERSION" ]; then
    READ_ABOUT_VERSION_PRESENT=0
fi

# run_test <fn>
#
# Returns immediately when the command under test is absent, recording an
# explicit failure for the test instead of running it against a missing
# executable. Prints one progress line per test so a slow run is visibly
# advancing; this changes output only, not assertions.
run_test() {
    _fn="$1"
    printf 'RUN %s\n' "$_fn"
    if [ "$COMMAND_PRESENT" -eq 0 ]; then
        fail "$_fn" "src/issue-branch is missing; contract cannot be exercised"
        return
    fi
    if [ "$FUNCTIONS_PRESENT" -eq 0 ]; then
        fail "$_fn" "src/functions.sh is missing; contract cannot be exercised"
        return
    fi
    if [ "$READ_ABOUT_VERSION_PRESENT" -eq 0 ]; then
        fail "$_fn" "src/read_about_version.py is missing; contract cannot be exercised"
        return
    fi
    "$_fn"
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------

test_create_uses_project_template_and_commits_dev_version() {
    make_project "$WORK/create"
    run_in "$WORK/create" create feature 6 local-clone-invocation
    assert_status "create exits 0" 0 "$RUN_STATUS"
    assert_branch "create leaves branch dev/6-local-clone-invocation" \
        "$WORK/create" "dev/6-local-clone-invocation"
    # Assert the COMMITTED version, not the file in the worktree. Reading it via
    # `status` output only proves a file was written; this proves it was
    # committed, which is what the test name claims.
    assert_eq "create commits PEP 440 dev version" \
        "1.4.0.dev1+issue-6-local-clone-invocation" \
        "$(cd "$WORK/create" && git show HEAD:sample/__about__.py | sed -n 's/^__version__ = "\(.*\)"/\1/p')"
    assert_eq "create leaves the dev version on disk" \
        "1.4.0.dev1+issue-6-local-clone-invocation" \
        "$(current_version_of "$WORK/create")"
    assert_clean_worktree "create leaves a clean worktree" "$WORK/create"
}

test_create_rejects_invalid_type() {
    make_project "$WORK/create-badtype"
    run_in "$WORK/create-badtype" create banana 6 local-clone-invocation
    assert_status "invalid type exits 1" 1 "$RUN_STATUS"
    assert_contains "create names the invalid type" "Invalid type:" "$RUN_OUT"
    assert_branch "invalid type creates no branch" "$WORK/create-badtype" "main"
}

test_create_rejects_non_numeric_issue() {
    make_project "$WORK/create-badissue"
    run_in "$WORK/create-badissue" create feature six local-clone-invocation
    assert_status "non-numeric issue exits 1" 1 "$RUN_STATUS"
    assert_contains "create names the non-numeric issue" "Issue number must be numeric:" "$RUN_OUT"
    assert_branch "non-numeric issue creates no branch" "$WORK/create-badissue" "main"
}

test_create_rejects_existing_branch() {
    make_project "$WORK/create-dup"
    run_in "$WORK/create-dup" create feature 6 local-clone-invocation
    # Assert the first create succeeded. Without this, two creates that both
    # fail for the same unrelated reason would make the second-exit-1
    # assertion pass while testing nothing about duplicate branches.
    assert_status "first create succeeds" 0 "$RUN_STATUS"
    assert_branch "first create makes the branch" \
        "$WORK/create-dup" "dev/6-local-clone-invocation"
    run_in "$WORK/create-dup" create feature 6 local-clone-invocation
    assert_status "duplicate branch exits 1" 1 "$RUN_STATUS"
}

test_create_rejects_dirty_tree() {
    make_project "$WORK/create-dirty"
    (cd "$WORK/create-dirty" && echo "dirty" >> sample/__about__.py)
    run_in "$WORK/create-dirty" create feature 7 dirty-tree
    assert_status "dirty tree exits 1" 1 "$RUN_STATUS"
    assert_contains "create names the dirty tree" "Tree contains uncommitted modifications:" "$RUN_OUT"
    assert_branch "dirty tree creates no branch" "$WORK/create-dirty" "main"
}

test_create_requires_base_branch() {
    make_project "$WORK/create-offbase"
    (cd "$WORK/create-offbase" && git checkout -qb dev/99-other)
    run_in "$WORK/create-offbase" create feature 8 off-base
    assert_status "create outside base exits 1" 1 "$RUN_STATUS"
    assert_contains "create names the off-base requirement" "Must be on main to run this command" "$RUN_OUT"
    assert_branch "create outside base leaves branch untouched" "$WORK/create-offbase" "dev/99-other"
}

test_create_fails_when_version_unreadable() {
    make_project "$WORK/create-badversion"
    # Corrupt the version source and COMMIT the corruption. cmd_create runs
    # require_clean_tree before the version read, so an uncommitted corruption
    # would abort with "Tree contains uncommitted modifications:" and this test
    # could never reach the version-read contract.
    (cd "$WORK/create-badversion" && \
        printf '__title__ = "sample"\n' > sample/__about__.py && \
        git add -A && git commit -qm "corrupt version source")
    run_in "$WORK/create-badversion" create feature 6 unreadable-version
    assert_status "unreadable version aborts create" 1 "$RUN_STATUS"
    assert_contains "create reports the unreadable version" \
        "Unable to read version from" "$RUN_OUT"
    # Deliberately NO branch assertion, unlike every other rejection test:
    # cmd_create checks out the new branch before the version read, so at GREEN
    # the failed create leaves the repo on dev/6-unreadable-version.
}

# ---------------------------------------------------------------------------
# resume
# ---------------------------------------------------------------------------

test_resume_checks_out_existing_branch() {
    make_project "$WORK/resume"
    run_in "$WORK/resume" create feature 6 local-clone-invocation
    (cd "$WORK/resume" && git checkout -q main)
    run_in "$WORK/resume" resume feature 6 local-clone-invocation
    assert_status "resume exits 0" 0 "$RUN_STATUS"
    assert_branch "resume checks out branch" "$WORK/resume" "dev/6-local-clone-invocation"
}

test_resume_bumps_dev_version() {
    make_project "$WORK/resume-version"
    run_in "$WORK/resume-version" create feature 6 local-clone-invocation
    (cd "$WORK/resume-version" && git checkout -q main)
    run_in "$WORK/resume-version" resume fix 6 local-clone-invocation
    assert_status "resume bump exits 0" 0 "$RUN_STATUS"
    assert_version "resume writes patch dev version" "$WORK/resume-version" \
        "1.3.1.dev1+issue-6-local-clone-invocation"
}

test_resume_rejects_missing_branch() {
    make_project "$WORK/resume-missing"
    run_in "$WORK/resume-missing" resume feature 6 local-clone-invocation
    assert_status "missing branch exits 1" 1 "$RUN_STATUS"
    assert_contains "resume names the missing branch" "Branch does not exist:" "$RUN_OUT"
    assert_branch "missing branch stays on main" "$WORK/resume-missing" "main"
}

# Guard G3: resume must preserve a bump-version correction instead of
# re-deriving the dev version from the base branch.
# ---------------------------------------------------------------------------
# bump-version
# ---------------------------------------------------------------------------

test_bump_version_rejects_base_branch() {
    make_project "$WORK/bump-base"
    run_in "$WORK/bump-base" bump-version --minor
    assert_status "bump on main exits 1" 1 "$RUN_STATUS"
    assert_contains "bump-version names the base branch" "bump-version must run on an issue branch, not main" "$RUN_OUT"
}

test_bump_version_requires_explicit_level() {
    make_project "$WORK/bump-default"
    run_in "$WORK/bump-default" create feature 6 local-clone-invocation
    _before="$(current_version_of "$WORK/bump-default")"
    run_in "$WORK/bump-default" bump-version
    assert_status "bump without level exits 1" 1 "$RUN_STATUS"
    assert_contains "bump-version names the missing level" "bump-version requires exactly one of" "$RUN_OUT"
    assert_eq "bump without level leaves version untouched" "$_before" \
        "$(current_version_of "$WORK/bump-default")"
}

test_bump_version_uses_explicit_level() {
    make_project "$WORK/bump"
    run_in "$WORK/bump" create feature 6 local-clone-invocation
    (cd "$WORK/bump" && git checkout -q main && git checkout -qb dev/7-patch-work)
    run_in "$WORK/bump" bump-version --patch
    assert_status "bump exits 0" 0 "$RUN_STATUS"
    assert_version "bump writes patch dev version" "$WORK/bump" \
        "1.3.1.dev1+issue-7-patch-work"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

test_status_is_non_mutating() {
    make_project "$WORK/status"
    run_in "$WORK/status" create feature 6 local-clone-invocation
    _before_head="$(cd "$WORK/status" && git rev-parse HEAD)"
    _before_version="$(current_version_of "$WORK/status")"
    _before_changelog="$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    _before_tags="$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    _before_changelog_worktree="$(cd "$WORK/status" && cat CHANGELOG.md)"
    run_in "$WORK/status" status
    assert_status "status exits 0" 0 "$RUN_STATUS"
    assert_contains "status reports branch" "Branch: dev/6-local-clone-invocation" "$RUN_OUT"
    assert_contains "status reports issue" "Issue: 6" "$RUN_OUT"
    assert_contains "status reports the current version value" \
        "Current version: 1.4.0.dev1+issue-6-local-clone-invocation" "$RUN_OUT"
    assert_contains "status reports release version" "Release version:" "$RUN_OUT"
    assert_contains "status reports test command" "Test command:" "$RUN_OUT"
    assert_contains "status reports changelog readiness" "Changelog:" "$RUN_OUT"
    assert_eq "status does not move HEAD" "$_before_head" \
        "$(cd "$WORK/status" && git rev-parse HEAD)"
    assert_eq "status does not change version" "$_before_version" \
        "$(current_version_of "$WORK/status")"
    assert_eq "status does not change changelog" "$_before_changelog" \
        "$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    assert_eq "status does not change tags" "$_before_tags" \
        "$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    # A write that is never committed is invisible to the HEAD/blob comparisons
    # above, so check the worktree itself.
    assert_clean_worktree "status leaves a clean worktree" "$WORK/status"
    assert_eq "status does not rewrite the changelog on disk" "$_before_changelog_worktree" \
        "$(cd "$WORK/status" && cat CHANGELOG.md)"
    assert_branch "status stays on issue branch" "$WORK/status" "dev/6-local-clone-invocation"
}

# ---------------------------------------------------------------------------
# changelog promotion
# ---------------------------------------------------------------------------

test_finish_promotes_changelog_and_tags() {
    make_project "$WORK/finish"
    run_in "$WORK/finish" create feature 6 local-clone-invocation
    (cd "$WORK/finish" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/finish" finish
    assert_status "finish exits 0" 0 "$RUN_STATUS"
    assert_branch "finish returns to base branch" "$WORK/finish" "main"
    assert_contains "finish promotes unreleased heading" \
        "## [1.4.0] - $(date +%Y-%m-%d)" "$(sed -n '1,40p' "$WORK/finish/CHANGELOG.md")"
    assert_contains "finish re-adds unreleased section" \
        "## [Unreleased]" "$(sed -n '1,40p' "$WORK/finish/CHANGELOG.md")"
    assert_contains "finish creates release tag" "v1.4.0" \
