# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

test_status_is_non_mutating() {
    make_project "$WORK/status"
    run_in "$WORK/status" create feature 6 local-clone-invocation
    _before_head="$(cd "$WORK/status" && git rev-parse HEAD)"
    _before_version="$(current_version_of "$WORK/status")"
    _before_changelog="$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    _before_tags="$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    _before_changelog_worktree="$(cd "$WORK/status" && cat CHANGELOG.md)"
    run_in "$WORK/status" status
    assert_status "status exits 0" 0 "$RUN_STATUS"
    assert_contains "status reports branch" "Branch: dev/6-local-clone-invocation" "$RUN_OUT"
    assert_contains "status reports issue" "Issue: 6" "$RUN_OUT"
    assert_contains "status reports current version" "Current version:" "$RUN_OUT"
    assert_contains "status reports release version" "Release version:" "$RUN_OUT"
    assert_contains "status reports test command" "Test command:" "$RUN_OUT"
    assert_contains "status reports changelog readiness" "Changelog:" "$RUN_OUT"
    assert_eq "status does not move HEAD" "$_before_head" \
        "$(cd "$WORK/status" && git rev-parse HEAD)"
    assert_eq "status does not change version" "$_before_version" \
        "$(current_version_of "$WORK/status")"
    assert_eq "status does not change changelog" "$_before_changelog" \
        "$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    assert_eq "status does not change tags" "$_before_tags" \
        "$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    # A write that is never committed is invisible to the HEAD/blob comparisons
    # above, so check the worktree itself.
    assert_clean_worktree "status leaves a clean worktree" "$WORK/status"
    assert_eq "status does not rewrite the changelog on disk" "$_before_changelog_worktree" \
        "$(cd "$WORK/status" && cat CHANGELOG.md)"
    assert_branch "status stays on issue branch" "$WORK/status" "dev/6-local-clone-invocation"
}

# ---------------------------------------------------------------------------
# changelog promotion
# ---------------------------------------------------------------------------

test_finish_promotes_changelog_and_tags() {
    make_project "$WORK/finish"
    run_in "$WORK/finish" create feature 6 local-clone-invocation
    (cd "$WORK/finish" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/finish" finish
    assert_status "finish exits 0" 0 "$RUN_STATUS"
    assert_branch "finish returns to base branch" "$WORK/finish" "main"
    assert_contains "finish promotes unreleased heading" \
        "## [1.4.0] - $(date +%Y-%m-%d)" "$(sed -n '1,40p' "$WORK/finish/CHANGELOG.md")"
    assert_contains "finish re-adds unreleased section" \
        "## [Unreleased]" "$(sed -n '1,40p' "$WORK/finish/CHANGELOG.md")"
    assert_contains "finish creates release tag" "v1.4.0" \
        "$(cd "$WORK/finish" && git tag -l)"
    assert_annotated_tag "finish tag is annotated" "$WORK/finish" "v1.4.0"
    _final="$(current_version_of "$WORK/finish")"
    assert_eq "finish writes final version" "1.4.0" "$_final"
}

test_finish_merge_message_closes_issue() {
    make_project "$WORK/finish-msg"
    run_in "$WORK/finish-msg" create feature 6 local-clone-invocation
    (cd "$WORK/finish-msg" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/finish-msg" finish
    assert_status "finish exits 0" 0 "$RUN_STATUS"
    _subject="$(cd "$WORK/finish-msg" && git log -1 --pretty=%s main)"
    assert_contains "finish merge message closes issue" "closes #6" "$_subject"
}

test_finish_rejects_missing_changelog() {
    make_project "$WORK/finish-nochangelog"
    (cd "$WORK/finish-nochangelog" && git rm -q CHANGELOG.md && git commit -qm "drop changelog")
    run_in "$WORK/finish-nochangelog" create feature 6 local-clone-invocation
    run_in "$WORK/finish-nochangelog" finish
    assert_status "missing changelog exits 1" 1 "$RUN_STATUS"
    assert_branch "missing changelog stays on branch" "$WORK/finish-nochangelog" "dev/6-local-clone-invocation"
}

test_finish_rejects_untracked_files() {
    make_project "$WORK/finish-untracked"
    run_in "$WORK/finish-untracked" create feature 6 local-clone-invocation
    (cd "$WORK/finish-untracked" && echo "- more" >> CHANGELOG.md && \
        git add -A && git commit -qm "work" && echo scratch > notes.txt)
    run_in "$WORK/finish-untracked" finish
    assert_status "untracked file aborts without confirmation" 1 "$RUN_STATUS"
    assert_contains "finish names the untracked file" "notes.txt" "$RUN_OUT"
    assert_branch "untracked file leaves issue branch" "$WORK/finish-untracked" \
        "dev/6-local-clone-invocation"
}

test_finish_skip_changelog_leaves_changelog_alone() {
    make_project "$WORK/finish-skipchangelog"
    run_in "$WORK/finish-skipchangelog" create feature 6 local-clone-invocation
    (cd "$WORK/finish-skipchangelog" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    # Compare verified blob IDs rather than piping through a hasher: with no
    # pipefail, two failing commands can yield two empty strings that compare
    # equal, so a broken lookup would pass as "unchanged".
    _before="$(cd "$WORK/finish-skipchangelog" && git rev-parse --verify dev/6-local-clone-invocation:CHANGELOG.md 2>/dev/null)"
    assert_ne "changelog blob resolves on the issue branch" "" "$_before"
    run_in "$WORK/finish-skipchangelog" finish --skip-changelog
    assert_status "finish --skip-changelog exits 0" 0 "$RUN_STATUS"
    _after="$(cd "$WORK/finish-skipchangelog" && git rev-parse --verify main:CHANGELOG.md 2>/dev/null)"
    assert_ne "changelog blob resolves on main" "" "$_after"
    assert_eq "finish --skip-changelog preserves content" "$_before" "$_after"
}

test_finish_recovery_tags_existing_merge() {
    make_project "$WORK/finish-recovery"
    run_in "$WORK/finish-recovery" create feature 6 local-clone-invocation
    (cd "$WORK/finish-recovery" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/finish-recovery" finish
    (cd "$WORK/finish-recovery" && git tag -d v1.4.0 >/dev/null)
    _head_before="$(cd "$WORK/finish-recovery" && git rev-parse HEAD)"
    _merge_count_before="$(cd "$WORK/finish-recovery" && git rev-list --merges --count HEAD)"
    run_in "$WORK/finish-recovery" finish
    assert_status "recovery finish exits 0" 0 "$RUN_STATUS"
    assert_contains "recovery (re)creates tag" "v1.4.0" \
        "$(cd "$WORK/finish-recovery" && git tag -l)"
    assert_eq "recovery creates no additional merge" "$_merge_count_before" \
        "$(cd "$WORK/finish-recovery" && git rev-list --merges --count HEAD)"
    assert_eq "recovery does not move base HEAD" "$_head_before" \
        "$(cd "$WORK/finish-recovery" && git rev-parse HEAD)"
}

test_finish_recovery_converts_dev_version_before_tagging() {
    make_project "$WORK/finish-recovery-dev"
    run_in "$WORK/finish-recovery-dev" create feature 6 local-clone-invocation
    (cd "$WORK/finish-recovery-dev" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    run_in "$WORK/finish-recovery-dev" finish
    assert_status "finish exits 0" 0 "$RUN_STATUS"
    (cd "$WORK/finish-recovery-dev" && git tag -d v1.4.0 >/dev/null && \
        printf '__version__ = "1.4.0.dev1+issue-6-local-clone-invocation"\n' > sample/__about__.py && \
        git add sample/__about__.py && git commit --amend --no-edit -q)
    run_in "$WORK/finish-recovery-dev" finish
    assert_status "dev recovery exits 0" 0 "$RUN_STATUS"
    assert_version "dev recovery writes release core" "$WORK/finish-recovery-dev" "1.4.0"
    assert_contains "dev recovery creates tag" "v1.4.0" \
        "$(cd "$WORK/finish-recovery-dev" && git tag -l)"
}

test_finish_rebases_before_changelog_promotion() {
    make_project "$WORK/finish-rebase-order"
    run_in "$WORK/finish-rebase-order" create feature 6 local-clone-invocation
    (cd "$WORK/finish-rebase-order" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    (cd "$WORK/finish-rebase-order" && git checkout -q main && \
        awk '/^## \[Unreleased\]/{print; print ""; print "- base note."; next} {print}' CHANGELOG.md > CHANGELOG.md.new && \
        mv CHANGELOG.md.new CHANGELOG.md && git add CHANGELOG.md && git commit -qm "base changelog note" && \
        git checkout -q dev/6-local-clone-invocation)
    run_in "$WORK/finish-rebase-order" finish
    assert_status "finish with advanced base exits 0" 0 "$RUN_STATUS"
    assert_branch "finish with advanced base returns to base" "$WORK/finish-rebase-order" "main"
    assert_contains "finish promotes against latest base" \
        "## [1.4.0] - $(date +%Y-%m-%d)" "$(sed -n '1,40p' "$WORK/finish-rebase-order/CHANGELOG.md")"
    _promoted="$(awk '/^## \[1\.4\.0\]/{in_release=1; next} in_release && /^## \[/{exit} in_release' "$WORK/finish-rebase-order/CHANGELOG.md")"
    assert_contains "promoted section includes base-branch note" "- base note." "$_promoted"
    assert_not_contains "merged changelog has no conflict markers" "<<<<<<<" \
        "$(cat "$WORK/finish-rebase-order/CHANGELOG.md")"
