    make_project "$WORK/release-branch"
    run_in "$WORK/release-branch" create feature 6 local-clone-invocation
    run_in "$WORK/release-branch" release --patch --skip-tests
    assert_status "release on issue branch exits 1" 1 "$RUN_STATUS"
}

