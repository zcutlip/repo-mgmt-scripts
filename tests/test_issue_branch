    (cd "$WORK/finish-rebase-order" && echo "- more" >> CHANGELOG.md && git add -A && git commit -qm "work")
    (cd "$WORK/finish-rebase-order" && git checkout -q main && \
        awk '/^## \[Unreleased\]/{print; print ""; print "- base note."; next} {print}' CHANGELOG.md > CHANGELOG.md.new && \
        mv CHANGELOG.md.new CHANGELOG.md && git add CHANGELOG.md && git commit -qm "base changelog note" && \
        git checkout -q dev/6-local-clone-invocation)
    run_in "$WORK/finish-rebase-order" finish
    assert_status "finish with advanced base exits 0" 0 "$RUN_STATUS"
    assert_branch "finish with advanced base returns to base" "$WORK/finish-rebase-order" "main"
    assert_contains "finish promotes against latest base" \
        "## [1.4.0] - 2026-" "$(sed -n '1,40p' "$WORK/finish-rebase-order/CHANGELOG.md")"
    _promoted="$(awk '/^## \[1\.4\.0\]/{in_release=1; next} in_release && /^## \[/{exit} in_release' "$WORK/finish-rebase-order/CHANGELOG.md")"
    assert_contains "promoted section includes base-branch note" "- base note." "$_promoted"
    assert_not_contains "merged changelog has no conflict markers" "<<<<<<<" \
        "$(cat "$WORK/finish-rebase-order/CHANGELOG.md")"
    assert_contains "finish creates release tag" "v1.4.0" \
        "$(cd "$WORK/finish-rebase-order" && git tag -l)"
}

