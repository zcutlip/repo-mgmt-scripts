# Guard G1: release must reject a dev version instead of mutating it.
#
# Asserting only "v1.4.0 absent" is not enough: the faulty path patch-bumps
# 1.4.0.dev0 to 1.4.1 and tags THAT, so a single-version probe passes while the
# wrong tag is created. Compare the whole tag set, the version, and the changelog
# before and after instead.
test_release_rejects_dev_version() {
    make_project "$WORK/release-dev" 1.4.0.dev0
    # Precondition: the guard is only reachable from the base branch, so assert
    # setup is genuinely in the state the guard needs. Otherwise a broken
    # fixture could make the test pass for the wrong reason.
    assert_branch "dev-version guard starts on base branch" "$WORK/release-dev" "main"
    assert_version "dev-version guard starts on a dev version" \
        "$WORK/release-dev" "1.4.0.dev0"
    _before_tags="$(cd "$WORK/release-dev" && git tag -l | tr '\n' ' ')"
    _before_changelog="$(cd "$WORK/release-dev" && git rev-parse --verify HEAD:CHANGELOG.md)"
    _before_head="$(cd "$WORK/release-dev" && git rev-parse HEAD)"

    run_in "$WORK/release-dev" release --skip-tests

    assert_status "release with dev version exits 1" 1 "$RUN_STATUS"
    assert_version "release leaves the dev version untouched" \
        "$WORK/release-dev" "1.4.0.dev0"
    assert_eq "release creates no tag at all" "$_before_tags" \
        "$(cd "$WORK/release-dev" && git tag -l | tr '\n' ' ')"
    assert_eq "release does not touch the changelog" "$_before_changelog" \
        "$(cd "$WORK/release-dev" && git rev-parse --verify HEAD:CHANGELOG.md)"
    assert_eq "release does not move HEAD" "$_before_head" \
        "$(cd "$WORK/release-dev" && git rev-parse HEAD)"
}

# Guard G2: release must fail when the version is already tagged instead of
# succeeding behind a duplicate changelog heading.
#
# Counting "## [1.3.0]" headings alone is not enough: the faulty path promotes
# [Unreleased] to 1.3.1, leaving exactly one 1.3.0 heading, so the count passes
# while the wrong release happens. Compare the full state before and after.
test_release_rejects_already_tagged() {
    make_project "$WORK/release-tagged"
    (cd "$WORK/release-tagged" && git tag v1.3.0 -m "version 1.3.0")
    # Preconditions: on the base branch, at 1.3.0, and already tagged.
    assert_branch "tagged guard starts on base branch" "$WORK/release-tagged" "main"
    assert_version "tagged guard starts at the tagged version" \
        "$WORK/release-tagged" "1.3.0"
    assert_contains "tagged guard starts with the tag present" "v1.3.0" \
        "$(cd "$WORK/release-tagged" && git tag -l)"
    _before_tags="$(cd "$WORK/release-tagged" && git tag -l | tr '\n' ' ')"
    _before_changelog="$(cd "$WORK/release-tagged" && git rev-parse --verify HEAD:CHANGELOG.md)"
    _before_head="$(cd "$WORK/release-tagged" && git rev-parse HEAD)"

    run_in "$WORK/release-tagged" release --skip-tests

    assert_status "release with existing tag exits 1" 1 "$RUN_STATUS"
    assert_version "release leaves the version untouched" \
        "$WORK/release-tagged" "1.3.0"
    assert_eq "release creates no additional tag" "$_before_tags" \
        "$(cd "$WORK/release-tagged" && git tag -l | tr '\n' ' ')"
    assert_eq "release does not touch the changelog" "$_before_changelog" \
        "$(cd "$WORK/release-tagged" && git rev-parse --verify HEAD:CHANGELOG.md)"
    assert_eq "release does not move HEAD" "$_before_head" \
        "$(cd "$WORK/release-tagged" && git rev-parse HEAD)"
    assert_count "release does not duplicate heading" "1" \
        "$(grep '^## \[1\.3\.0\]' "$WORK/release-tagged/CHANGELOG.md" || true)"
}

