test_release_leaves_version_and_tags_it() {
    # Release 1.4.0, NOT the fixture's own 1.3.0: the fixture changelog already
    # contains a released "## [1.3.0] - 2026-09-17" entry, so promoting
    # [Unreleased] to 1.3.0 would write a second identical heading. A version
    # newer than the changelog history is the realistic ready-to-release state.
    make_project "$WORK/release-keep" 1.4.0
    run_in "$WORK/release-keep" release --skip-tests
    assert_status "release exits 0" 0 "$RUN_STATUS"
    assert_version "release leaves version untouched" "$WORK/release-keep" "1.4.0"
    assert_annotated_tag "release tag is annotated" "$WORK/release-keep" "v1.4.0"
    assert_contains "release promotes unreleased heading" \
        "## [1.4.0] - $(date +%Y-%m-%d)" \
        "$(sed -n '1,40p' "$WORK/release-keep/CHANGELOG.md")"
    # Exactly one 1.4.0 heading: a second would mean promotion duplicated the
    # release rather than moving the section.
    assert_count "release writes exactly one release heading" "1" \
        "$(grep '^## \[1\.4\.0\]' "$WORK/release-keep/CHANGELOG.md" || true)"
}

