        printf '# Changelog\n\n## [Unreleased]\n\n## [1.3.0] - 2026-09-17\n\n- old\n' > CHANGELOG.md && \
        git add -A && git commit -qm "empty unreleased")
    run_in "$WORK/release-empty" release --patch --skip-tests
    assert_status "release with empty unreleased exits 1" 1 "$RUN_STATUS"
}

