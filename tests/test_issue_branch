# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

test_status_is_non_mutating() {
    make_project "$WORK/status"
    run_in "$WORK/status" create feature 6 local-clone-invocation
    _before_head="$(cd "$WORK/status" && git rev-parse HEAD)"
    _before_version="$(current_version_of "$WORK/status")"
    _before_changelog="$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    _before_tags="$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    run_in "$WORK/status" status
    assert_status "status exits 0" 0 "$RUN_STATUS"
    assert_contains "status reports branch" "Branch: dev/6-local-clone-invocation" "$RUN_OUT"
    assert_contains "status reports issue" "Issue: 6" "$RUN_OUT"
    assert_contains "status reports current version" "Current version:" "$RUN_OUT"
    assert_contains "status reports release version" "Release version:" "$RUN_OUT"
    assert_contains "status reports test command" "Test command:" "$RUN_OUT"
    assert_contains "status reports changelog readiness" "Changelog:" "$RUN_OUT"
    assert_eq "status does not move HEAD" "$_before_head" \
        "$(cd "$WORK/status" && git rev-parse HEAD)"
    assert_eq "status does not change version" "$_before_version" \
        "$(current_version_of "$WORK/status")"
    assert_eq "status does not change changelog" "$_before_changelog" \
        "$(cd "$WORK/status" && git rev-parse HEAD:CHANGELOG.md)"
    assert_eq "status does not change tags" "$_before_tags" \
        "$(cd "$WORK/status" && git tag -l | tr '\n' ' ')"
    assert_branch "status stays on issue branch" "$WORK/status" "dev/6-local-clone-invocation"
}

