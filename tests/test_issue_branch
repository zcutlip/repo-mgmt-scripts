#!/bin/sh
# shellcheck disable=SC2329  # test functions are invoked indirectly by the runner
#
# Tests for src/issue-branch.
#
# Shell-only harness: builds a throwaway project in a temp directory, copies
# the scripts under test next to a project_settings.sh, and drives the
# lifecycle command through its branches. No external test framework.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SRC_DIR="$REPO_ROOT/src"
ISSUE_BRANCH="$SRC_DIR/issue-branch"

PASS=0
FAIL=0
FAILED_NAMES=""

# ---------------------------------------------------------------------------
# assertions
# ---------------------------------------------------------------------------

fail() {
    _name="$1"
    _detail="$2"
    printf 'FAIL: %s\n  %s\n' "$_name" "$_detail"
    FAIL=$((FAIL + 1))
    FAILED_NAMES="$FAILED_NAMES
  $_name"
}

pass() {
    PASS=$((PASS + 1))
}

assert_status() {
    _name="$1"
    _expected="$2"
    _actual="$3"
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected exit $_expected, got $_actual"
    fi
}

assert_eq() {
    _name="$1"
    _expected="$2"
    _actual="$3"
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected '$_expected', got '$_actual'"
    fi
}

assert_contains() {
    _name="$1"
    _needle="$2"
    _haystack="$3"
    case "$_haystack" in
        *"$_needle"*) pass ;;
        *) fail "$_name" "expected output to contain '$_needle'; got: $_haystack" ;;
    esac
}

assert_not_contains() {
    _name="$1"
    _needle="$2"
    _haystack="$3"
    case "$_haystack" in
        *"$_needle"*) fail "$_name" "expected output to omit '$_needle'; got: $_haystack" ;;
        *) pass ;;
    esac
}

# assert_branch <name> <dir> <expected>
assert_branch() {
    _name="$1"
    _dir="$2"
    _expected="$3"
    _actual="$(cd "$_dir" && git branch --show-current 2>/dev/null)"
    assert_eq "$_name" "$_expected" "$_actual"
}

assert_annotated_tag() {
    _name="$1"
    _dir="$2"
    _tag="$3"
    _type="$(cd "$_dir" && git cat-file -t "$_tag" 2>/dev/null)"
    assert_eq "$_name" "tag" "$_type"
}

assert_absent_tag() {
    _name="$1"
    _dir="$2"
    _tag="$3"
    _actual="$(cd "$_dir" && git tag -l "$_tag")"
    assert_eq "$_name" "" "$_actual"
}

assert_version() {
    _name="$1"
    _dir="$2"
    _expected="$3"
    _actual="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$_dir/sample/__about__.py")"
    assert_eq "$_name" "$_expected" "$_actual"
}

# assert_ne <name> <unexpected> <actual>
assert_ne() {
    _name="$1"
    _unexpected="$2"
    _actual="$3"
    if [ "$_unexpected" != "$_actual" ]; then
        pass
    else
        fail "$_name" "expected a value other than '$_unexpected'"
    fi
    unset _name _unexpected _actual
}

# assert_clean_worktree <name> <dir>
#
# Asserts the working tree has no modified or untracked files. Guards against
# a command that writes to disk without committing, which a HEAD-based
# comparison cannot see.
assert_clean_worktree() {
    _name="$1"
    _dir="$2"
    _dirty="$(cd "$_dir" && git status --porcelain)"
    if [ -z "$_dirty" ]; then
        pass
    else
        fail "$_name" "expected a clean worktree; got: $_dirty"
    fi
    unset _name _dir _dirty
}

# assert_count <name> <expected_count> <text>
#
# Counts the lines in the multi-line string <text> and compares against
# <expected_count>. Callers pre-filter (e.g. with grep) so the helper
# itself stays generic.
assert_count() {
    _name="$1"
    _expected="$2"
    _text="$3"
    if [ -z "$_text" ]; then
        _actual=0
    else
        _actual="$(printf '%s\n' "$_text" | grep -c .)"
    fi
    if [ "$_expected" = "$_actual" ]; then
        pass
    else
        fail "$_name" "expected $_expected matching lines, got $_actual"
    fi
    unset _name _expected _text _actual
}

current_version_of() {
    sed -n 's/^__version__ = "\(.*\)"/\1/p' "$1/sample/__about__.py"
}

# ---------------------------------------------------------------------------
# fixture
# ---------------------------------------------------------------------------

# make_project <dir> [version]
#
# Creates a git repo at <dir> with:
#   pyproject.toml, README.md
#   sample/__about__.py           (__version__ = <version>, default 1.3.0)
#   CHANGELOG.md                  (non-empty [Unreleased], plus a 1.3.0 entry)
#   scripts/issue-branch-*        (scripts under test)
#   scripts/run-tests.sh          (overridable by the test)
#   scripts/project_settings.sh   (test project settings)
#
# The changelog always contains a released "## [1.3.0] - 2026-09-17" entry, so a
# test that releases <version> should pass a version NEWER than 1.3.0 unless it is
# deliberately exercising a re-release of 1.3.0. Releasing 1.3.0 from this
# fixture would promote [Unreleased] to a second "## [1.3.0]" heading.
make_project() {
    _dir="$1"
    _version="${2:-1.3.0}"
    mkdir -p "$_dir/sample" "$_dir/scripts"

    cat > "$_dir/pyproject.toml" <<'EOF'
[project]
name = "sample-project"
dynamic = ["version"]
EOF

    printf '__version__ = "%s"\n' "$_version" > "$_dir/sample/__about__.py"

    cat > "$_dir/README.md" <<'EOF'
# sample project
EOF

    cat > "$_dir/CHANGELOG.md" <<'EOF'
# Changelog

## [Unreleased]

### Added

- Something new.

## [1.3.0] - 2026-09-17

### Added

- Previous release.
EOF

    cp "$SRC_DIR/issue-branch" "$_dir/scripts/issue-branch"
    cp "$SRC_DIR/functions.sh" "$_dir/scripts/functions.sh"
    cp "$SRC_DIR/read_about_version.py" "$_dir/scripts/read_about_version.py"
    chmod +x "$_dir/scripts/issue-branch"

    cat > "$_dir/scripts/run-tests.sh" <<'EOF'
#!/bin/sh
exit 0
EOF
    chmod +x "$_dir/scripts/run-tests.sh"

    cat > "$_dir/scripts/project_settings.sh" <<'EOF'
ROOT_PACKAGE_NAME="sample"
ISSUE_BRANCH_TEMPLATE="dev/{issue}-{slug}"
ISSUE_BRANCH_BASE="main"
ISSUE_BRANCH_TEST_COMMAND="scripts/run-tests.sh"
ISSUE_BRANCH_CHANGELOG="CHANGELOG.md"
TWINE_UPLOAD_ENABLED="0"
EOF

    (
        cd "$_dir" || exit 1
        git init -q -b main
        git config user.email "test@example.com"
        git config user.name "Test"
        # Disable signing so throwaway repos ignore the developer's global git config.
        git config commit.gpgsign false
        git config tag.gpgsign false
        git config tag.forcesignannotated false
        git add -A
        git commit -qm "initial commit"
    )
    unset _dir _version
}

# run_in <dir> <args...>  -> exit status in RUN_STATUS
run_in() {
    _dir="$1"
    shift
    RUN_OUT="$(cd "$_dir" && ./scripts/issue-branch "$@" 2>&1)"
    RUN_STATUS=$?
    # shellcheck disable=SC2034  # captured for failure-message context
    LAST_OUT="$RUN_OUT"
}

# ---------------------------------------------------------------------------
# temp workspace
# ---------------------------------------------------------------------------

WORK="$(mktemp -d "${TMPDIR:-/tmp}/issue-branch-test.XXXXXX")" || {
    printf 'FAIL: mktemp -d failed; cannot run tests\n' >&2
    exit 1
}
# An empty WORK would turn every make_project path into an absolute path under
# / (e.g. "/sample"), writing outside the sandbox. Guard rather than trust.
[ -n "$WORK" ] && [ -d "$WORK" ] || {
    printf 'FAIL: mktemp -d produced no directory\n' >&2
    exit 1
}
trap 'rm -rf "$WORK"' EXIT INT TERM

# ---------------------------------------------------------------------------
# preconditions
# ---------------------------------------------------------------------------

# The command under test is the deliverable; when it is absent, every test
# fails. Report each test independently instead of aborting the run so RED
# shows the full contract surface.
COMMAND_PRESENT=1
if [ ! -x "$ISSUE_BRANCH" ]; then
    COMMAND_PRESENT=0
fi

# run_test <fn>
#
# Returns immediately when the command under test is absent, recording an
# explicit failure for the test instead of running it against a missing
# executable. Prints one progress line per test so a slow run is visibly
# advancing; this changes output only, not assertions.
run_test() {
    _fn="$1"
    printf 'RUN %s\n' "$_fn"
    if [ "$COMMAND_PRESENT" -eq 0 ]; then
        fail "$_fn" "src/issue-branch is missing; contract cannot be exercised"
        return
    fi
    "$_fn"
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------

test_create_uses_project_template_and_commits_dev_version() {
    make_project "$WORK/create"
    run_in "$WORK/create" create feature 6 local-clone-invocation
    assert_status "create exits 0" 0 "$RUN_STATUS"
    assert_branch "create leaves branch dev/6-local-clone-invocation" \
        "$WORK/create" "dev/6-local-clone-invocation"
    # Assert the COMMITTED version, not the file in the worktree. Reading it via
    # `status` output only proves a file was written; this proves it was
    # committed, which is what the test name claims.
    assert_eq "create commits PEP 440 dev version" \
        "1.4.0.dev1+issue-6-local-clone-invocation" \
        "$(cd "$WORK/create" && git show HEAD:sample/__about__.py | sed -n 's/^__version__ = "\(.*\)"/\1/p')"
    assert_eq "create leaves the dev version on disk" \
        "1.4.0.dev1+issue-6-local-clone-invocation" \
        "$(current_version_of "$WORK/create")"
    assert_clean_worktree "create leaves a clean worktree" "$WORK/create"
}

test_create_rejects_invalid_type() {
    make_project "$WORK/create-badtype"
    run_in "$WORK/create-badtype" create banana 6 local-clone-invocation
    assert_status "invalid type exits 1" 1 "$RUN_STATUS"
    assert_branch "invalid type creates no branch" "$WORK/create-badtype" "main"
}

test_create_rejects_non_numeric_issue() {
    make_project "$WORK/create-badissue"
    run_in "$WORK/create-badissue" create feature six local-clone-invocation
    assert_status "non-numeric issue exits 1" 1 "$RUN_STATUS"
    assert_branch "non-numeric issue creates no branch" "$WORK/create-badissue" "main"
}

test_create_rejects_existing_branch() {
    make_project "$WORK/create-dup"
    run_in "$WORK/create-dup" create feature 6 local-clone-invocation
    # Assert the first create succeeded. Without this, two creates that both
    # fail for the same unrelated reason would make the second-exit-1
    # assertion pass while testing nothing about duplicate branches.
    assert_status "first create succeeds" 0 "$RUN_STATUS"
    assert_branch "first create makes the branch" \
        "$WORK/create-dup" "dev/6-local-clone-invocation"
    run_in "$WORK/create-dup" create feature 6 local-clone-invocation
    assert_status "duplicate branch exits 1" 1 "$RUN_STATUS"
}

test_create_rejects_dirty_tree() {
    make_project "$WORK/create-dirty"
    (cd "$WORK/create-dirty" && echo "dirty" >> sample/__about__.py)
    run_in "$WORK/create-dirty" create feature 7 dirty-tree
    assert_status "dirty tree exits 1" 1 "$RUN_STATUS"
    assert_branch "dirty tree creates no branch" "$WORK/create-dirty" "main"
}

test_create_requires_base_branch() {
    make_project "$WORK/create-offbase"
    (cd "$WORK/create-offbase" && git checkout -qb dev/99-other)
    run_in "$WORK/create-offbase" create feature 8 off-base
    assert_status "create outside base exits 1" 1 "$RUN_STATUS"
    assert_branch "create outside base leaves branch untouched" "$WORK/create-offbase" "dev/99-other"
}

