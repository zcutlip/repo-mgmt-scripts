    run_in "$WORK/resume-missing" resume feature 6 local-clone-invocation
    assert_status "missing branch exits 1" 1 "$RUN_STATUS"
    assert_branch "missing branch stays on main" "$WORK/resume-missing" "main"
}

# Guard G3: resume must preserve a bump-version correction instead of
# re-deriving the dev version from the base branch.
test_resume_preserves_bump_version_correction() {
    make_project "$WORK/resume-bump"
    run_in "$WORK/resume-bump" create feature 6 local-clone-invocation
    run_in "$WORK/resume-bump" bump-version --minor
    _saved="$(current_version_of "$WORK/resume-bump")"
    assert_eq "bump writes minor dev version" \
        "1.5.0.dev1+issue-6-local-clone-invocation" "$_saved"
    (cd "$WORK/resume-bump" && git checkout -q main)
    run_in "$WORK/resume-bump" resume feature 6 local-clone-invocation
    assert_status "resume exits 0" 0 "$RUN_STATUS"
    assert_eq "resume preserves bump correction" "$_saved" \
        "$(current_version_of "$WORK/resume-bump")"
}

